            android:textSize="20dp"
            android:id="@+id/main_test25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开AC"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内循环"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test27"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="外循环"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test28"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开ION"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test29"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开AQS"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开除霜 "/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test40"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="车窗微开 "/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开行车记录仪"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test51"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拍照"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test52"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连拍"/>
    </LinearLayout>
</ScrollView>
