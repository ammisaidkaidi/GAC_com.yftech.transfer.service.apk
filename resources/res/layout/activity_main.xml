            android:textSize="20dp"
            android:id="@+id/main_test19"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="温度调到20度"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="温度增加3"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="温度减小2"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test22"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
