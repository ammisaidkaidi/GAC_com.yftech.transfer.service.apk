            android:id="@+id/main_test2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="亮度增加3"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="白天模式"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="黑夜模式"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="氛围灯上一个"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="氛围灯下一个"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="氛围灯变亮"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="风量调到4"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="风量增加2"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="风量减小3"/>
        <Button
            android:textSize="20dp"
            android:id="@+id/main_test13"
            android:layout_width="match_parent"
