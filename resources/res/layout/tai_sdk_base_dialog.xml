<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/tai_sdk_bg_base_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/message_layout"
        android:layout_width="@dimen/tai_sdk_base_dialog_width"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/tai_sdk_text_size_28"
            android:textColor="@color/tai_sdk_base_dialog_msg_text_color"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tai_sdk_base_dialog_tv_message_margin_left"
            android:layout_marginTop="@dimen/tai_sdk_tp_45"
            android:layout_marginRight="@dimen/tai_sdk_base_dialog_tv_message_margin_right"
            android:layout_marginBottom="@dimen/tai_sdk_tp_50"/>
        <TextView
            android:textSize="@dimen/tai_sdk_text_size_18"
            android:textColor="@color/tai_sdk_base_dialog_msg_text_color"
            android:gravity="center"
            android:id="@+id/tv_sub_message"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/tai_sdk_base_dialog_tv_message_margin_left"
            android:layout_marginRight="@dimen/tai_sdk_base_dialog_tv_message_margin_right"
            android:layout_marginBottom="@dimen/tai_sdk_tp_30"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_h"
        style="@style/tai_sdk_horizonal_divider"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btn_container"
        android:layout_width="@dimen/tai_sdk_base_dialog_btn_container_width"
        android:layout_height="@dimen/tai_sdk_base_dialog_btn_container_height">
        <TextView
            android:textSize="@dimen/tai_sdk_text_size_27"
            android:textColor="@color/tai_sdk_base_dialog_blue_btn_text_color"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/divider_v"
            style="@style/tai_sdk_vertical_divider"/>
        <TextView
            android:textSize="@dimen/tai_sdk_text_size_27"
            android:textColor="@color/tai_sdk_base_dialog_grey_btn_text_color"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
