<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/tai_sdk_rg_dialog_w"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/tai_sdk_rg_dialog_w">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/message_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/tai_sdk_rg_dialog_msg_textsize"
                android:gravity="center"
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tai_sdk_rg_dialog_msg_margin_left"
                android:layout_marginTop="@dimen/tai_sdk_rg_dialog_msg_margin_top"
                android:layout_marginRight="@dimen/tai_sdk_rg_dialog_msg_margin_right"
                android:layout_marginBottom="@dimen/tai_sdk_rg_dialog_msg_margin_bottom"
                android:text="@string/tai_sdk_ok"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_one_layout"
            android:layout_width="@dimen/tai_sdk_rg_dialog_w"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/tai_sdk_rg_dialog_w"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/tai_sdk_rg_dialog_btn_textsize"
                android:gravity="center"
                android:id="@+id/btn_one_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tai_sdk_rg_dialog_btn_h"
                android:text="@string/tai_sdk_ok"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
