<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start|center_vertical"
    android:orientation="vertical"
    android:background="#f3434551"
    android:paddingTop="@dimen/tp16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/wbsdk_layout_popup_view_top_bar"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/tp40"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tp120"
        android:layout_marginTop="@dimen/tp6"
        android:layout_marginBottom="@dimen/tp6">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true">
            <TextView
                android:textSize="@dimen/tp30"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@+id/popup_view_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="您已进入腾讯智慧停车场"/>
            <TextView
                android:textSize="@dimen/tp24"
                android:textColor="#e6e6e6"
                android:gravity="center_vertical"
                android:id="@+id/popup_view_detail"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tp12"
                android:text="当前停车场支持自动支付，您可进入腾讯我的车公众号，开通停车费自动支付。"
                android:maxLines="2"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/popup_view_bottom_bar"
        android:background="#1d1e2c"
        android:paddingLeft="@dimen/tp40"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tp54">
        <ImageView
            android:id="@+id/popup_view_bottom_bar_logo"
            android:paddingRight="@dimen/tp7"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_park_sp_etcp"
            android:scaleType="center"/>
        <TextView
            android:textSize="@dimen/tp15"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/popup_view_bottom_bar_logo_name"
            android:paddingRight="@dimen/tp20"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="ETCP"/>
    </LinearLayout>
</LinearLayout>
