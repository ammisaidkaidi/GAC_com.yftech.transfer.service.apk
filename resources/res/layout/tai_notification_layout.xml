<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/tai_sdk_tp_16"
    android:layout_marginBottom="@dimen/tai_sdk_tp_16"
    android:layout_alignParentBottom="true">
    <com.tencent.wecarbase.taibaseui.commonui.shadow.TAIShadowLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:shadow_color="#33000000"
        app:shadow_dx="0dp"
        app:shadow_dy="0dp"
        app:shadow_elevation="@dimen/tai_sdk_tp_8"
        app:shadow_radius="@dimen/tai_sdk_tp_8">
        <LinearLayout
            android:id="@+id/tai_sub_notification_layout"
            android:background="@drawable/tai_pop_status_bar_bg_normal"
            android:layout_width="@dimen/push_poi_notification_width"
            android:layout_height="@dimen/tai_sdk_tp_144">
            <ImageView
                android:id="@+id/tai_app_icon"
                android:layout_width="@dimen/push_poi_notification_icon_width"
                android:layout_height="@dimen/tai_sdk_tp_144"
                android:src="@drawable/tai_pop_common_status_bar_header"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/tai_sdk_tp_32"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/push_poi_notification_main_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/tai_push_notify_text_color"
                    android:ellipsize="end"
                    android:id="@+id/tai_notification_title"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/push_poi_notification_address_text_size"
                    android:textColor="@color/tai_push_notify_address_text_color"
                    android:ellipsize="end"
                    android:id="@+id/address"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/push_poi_notification_address_text_margin_top"
                    android:text="@string/app_name"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tai_notification_click_layout"
                android:layout_width="@dimen/push_poi_notification_click_area_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/n_notification_click_iv_layout"
                    android:layout_width="@dimen/push_poi_notification_click_iv_size"
                    android:layout_height="@dimen/push_poi_notification_click_iv_size">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tai_notification_click_iv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tai_pop_status_bar_tip_click_image"
                        android:scaleType="centerInside"/>
                    <com.tencent.wecarbase.taibaseui.notification.DelayCloseView
                        android:id="@+id/tai_notification_delay_close_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/tai_sdk_tp_1"/>
                </FrameLayout>
                <TextView
                    android:textSize="@dimen/n_common_map_textsize_search"
                    android:textColor="@color/tai_push_maphome_tip_click_color"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tai_notification_click_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tai_sdk_tp_18"
                    android:text="@string/tai_notification_open"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/tai_notification_cancel_layout"
                android:layout_width="@dimen/push_poi_notification_click_area_width"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/tai_sdk_tp_32">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tai_notification_cancel_iv"
                    android:background="@drawable/tai_pop_status_bar_tip_close_click"
                    android:layout_width="@dimen/push_poi_notification_click_iv_size"
                    android:layout_height="@dimen/push_poi_notification_click_iv_size"
                    android:src="@drawable/tai_pop_status_bar_tip_close_click_image"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="@dimen/n_common_map_textsize_search"
                    android:textColor="@color/tai_push_maphome_tip_close_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tai_notification_cancel_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tai_sdk_tp_18"
                    android:maxWidth="@dimen/push_poi_notification_click_area_width"
                    android:text="@string/n_status_bar_tip_close_text"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.tencent.wecarbase.taibaseui.commonui.shadow.TAIShadowLayout>
</LinearLayout>
