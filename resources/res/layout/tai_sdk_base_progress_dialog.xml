<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/tai_sdk_bg_base_dialog"
    android:layout_width="@dimen/tai_sdk_base_progress_dialog_width"
    android:layout_height="@dimen/tai_sdk_base_progress_dialog_height">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="@dimen/tai_sdk_base_progress_dialog_width"
        android:layout_height="@dimen/tai_sdk_base_progress_dialog_height">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/loading_iv"
            android:background="@drawable/tai_sdk_progress_dialog_rolling_icon"
            android:layout_width="@dimen/tai_sdk_base_progress_dialog_loading_iv_size"
            android:layout_height="@dimen/tai_sdk_base_progress_dialog_loading_iv_size"/>
        <TextView
            android:textSize="@dimen/tai_sdk_text_size_30"
            android:textColor="@color/tai_sdk_base_dialog_msg_text_color"
            android:gravity="center"
            android:id="@+id/msg_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tai_sdk_tp_47"/>
    </LinearLayout>
</LinearLayout>
