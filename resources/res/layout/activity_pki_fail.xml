<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/img_popup_mask"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/com_bz_popup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px">
        <TextView
            android:textSize="22px"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/id_text_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="144px"
            android:text="@string/pki_fail_tips"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="10px"/>
        <Button
            android:textSize="24px"
            android:textColor="@android:color/white"
            android:id="@+id/id_button_ok"
            android:background="@drawable/com_btn_popupbtn_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pki_fail_tips_ok"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
